        return;
    }

    /* 2. ОЧИСТКА: Обнуляем теневой (Back) буфер ОЗУ через memset за 1 такт */
    //OLED_Clear(OLED_COLOR_BLACK);
    
    /* 3. АТОМАРНЫЙ СНИМОК: Копируем данные из быстрого прерывания FSM (20 кГц) */
    //ui_data_snap.target_current = Inverter.target_current;
    //ui_data_snap.actual_voltage = Inverter.actual_voltage;
    //ui_data_snap.state          = Inverter.state;
    //ui_data_snap.fault_code     = Inverter.fault_code; 

    /* ========================================================================== */
    /* ЗОНА 1 (Верхняя, Y = 2): Крупный Ток уставки или Мигающий Экран Аварии     */
    /* ========================================================================== */
    //if (ui_data_snap.state == SYS_STATE_FAULT) {
        /* Отображаем текст аварии сразу, без привязки к таймеру мигания.
           Мигание отражает наличие активной неисправности, детектируемой FSM. */
    /*    switch (ui_data_snap.fault_code) {
            case FAULT_CODE_OVERCURRENT:        UI_PrintBigStr(16, 2, "SHORT!");  break;
            case FAULT_CODE_LOW_15V:            UI_PrintBigStr(10, 2, "220V-!");  break;
            case FAULT_CODE_OVERHEAT_IGBT:
            case FAULT_CODE_OVERHEAT_DIO:       UI_PrintBigStr(28, 2, "HOT!!");   break;
            case FAULT_CODE_FAN_BLOCKED:        UI_PrintBigStr(20, 2, "FAN ER");  break;
            case FAULT_CODE_SENSOR_OPEN:        UI_PrintBigStr(10, 2, "TSENSOR"); break;
            default:                            UI_PrintBigStr(28, 2, "ERROR");   break;
        }
    } else {
        /* ВЫВОД КРУПНЫХ ЦИФР ТЕКУЩЕГО ТОКА С ПОДАВЛЕНИЕМ ВЕДУЩЕГО НУЛЯ */
    /*    char cur_buff[5];
        int current_int = (int)ui_data_snap.target_current;
        
        cur_buff[0] = (current_int / 100) + '0'; 
        cur_buff[1] = ((current_int % 100) / 10) + '0'; 
        cur_buff[2] = (current_int % 10) + '0'; 
        cur_buff[3] = 'A';
        cur_buff[4] = '\0';
        
        if (cur_buff[0] == '0') {
            UI_PrintBigStr(38, 2, &cur_buff[1]); // Центрируем строку, если ток двухзначный
        } else {
            UI_PrintBigStr(28, 2, cur_buff);
        }*/
    }

    /* РАЗДЕЛИТЕЛЬНАЯ ГЕОМЕТРИЧЕСКАЯ ЛИНИЯ */
    UI_DrawHorizontalLine(0, 127, 37, 1);

    /* ========================================================================== */
    /* ЗОНА 2 (Нижняя, Y = 44): Информационный бар мелким шрифтом 8x16            */
    /* ========================================================================== */
    char bar_buff[8];

    // --- ПОДЗОНА 2.1: Левый угол (X = 4) -> Настраиваемая уставка тока или вольт ХХ ---
    if (current_selected_mode == 1) {
        // Режим Lift-TIG: уставка всегда только по току
        int cur_set = (int)ui_data_snap.target_current;
        bar_buff[0] = (cur_set / 100) + '0';
        bar_buff[1] = ((cur_set % 100) / 10) + '0';
        bar_buff[2] = (cur_set % 10) + '0';
        bar_buff[3] = 'A';
        bar_buff[4] = '\0';
        
        if (bar_buff[0] == '0') UI_PrintStr_8x16(4, 44, &bar_buff[1], 1);
        else UI_PrintStr_8x16(4, 44, bar_buff, 1);
    } else {
        // Режим MMA: выводим то, на чем сейчас сфокусирован клик энкодера
        if (ui_edit_target == 0) {
            int cur_set = (int)ui_data_snap.target_current;
            bar_buff[0] = (cur_set / 100) + '0';
            bar_buff[1] = ((cur_set % 100) / 10) + '0';
            bar_buff[2] = (cur_set % 10) + '0';
            bar_buff[3] = 'A';
            bar_buff[4] = '\0';
            
            if (bar_buff[0] == '0') UI_PrintStr_8x16(4, 44, &bar_buff[1], 1);
            else UI_PrintStr_8x16(4, 44, bar_buff, 1);
        } else {
            // Если переключились на Вольты — выводим жестко заданную уставку вольт ХХ (например, 75.0V)
            bar_buff[0] = '7'; 
            bar_buff[1] = '5'; 
            bar_buff[2] = '.'; 
            bar_buff[3] = '0'; 
            bar_buff[4] = 'V';
            bar_buff[5] = '\0';
            
            UI_PrintStr_8x16(4, 44, bar_buff, 1);
        }
    }

    // --- ПОДЗОНА 2.2: Центр (X = 52) -> Реальное измеряемое напряжение дуги из АЦП ---
    // Формула точного целочисленного округления без float математики на стеке
    uint32_t volt_meas = (((uint32_t)ui_data_snap.actual_voltage * 1000U) + 2048U) / 4096U;
    if (volt_meas > 999U) volt_meas = 999U; // Защитный барьер переполнения разрядности строки

    char meas_buff[8];
    meas_buff[0] = (volt_meas / 100) + '0'; 
    meas_buff[1] = ((volt_meas % 100) / 10) + '0'; 
    meas_buff[2] = '.'; 
    meas_buff[3] = (volt_meas % 10) + '0'; 
    meas_buff[4] = 'V';
    meas_buff[5] = '\0';

    UI_PrintStr_8x16(52, 44, meas_buff, 1); 

    // --- ПОДЗОНА 2.3: Правый угол (X = 96) -> Маркер выбранного режима MMA/TIG ---
    if (current_selected_mode == 0) {
    UI_PrintStr_8x16(96, 44, "MMA", 1);
    } 
    else {UI_PrintStr_8x16(96, 44, "TIG", 1);}

    // 4.Ассинхронный флип ( подмена указателей), кадр мгновенно улетает по DMA
    OLED_Swap_Buffers();
}
