/* ========================================================================== */
/*                       НИЗКОУРОВНЕВЫЕ ГРАФИЧЕСКИЕ ПРИМИТИВЫ                 */
/* ========================================================================== */

/**
 * @brief Попиксельная отрисовка строго в текущий скрытый буфер (Back Buffer)
 */
static void UI_DrawPixel_BackBuf(int x, int y, uint8_t color) {
    if (x < 0 || x >= (int)SSD1306_WIDTH || y < 0 || y >= (int)SSD1306_HEIGHT) return;
    
    // Получаем адрес буфера, в котором сейчас идет рендеринг в ОЗУ
    uint8_t *back_buf = OLED_Get_BackBuffer_Ptr();
    if (back_buf == NULL) return;

    if (color) {
        back_buf[x + (y / 8) * SSD1306_WIDTH] |= (1 << (y % 8));
    } else {
        back_buf[x + (y / 8) * SSD1306_WIDTH] &= ~(1 << (y % 8));
    }
}

/**
 * @brief Высокоскоростная отрисовка горизонтальной разделительной линии
 */
static void UI_DrawHorizontalLine(int x1, int x2, int y, uint8_t color) {
    if (x1 < 0) x1 = 0;
    if (x2 >= (int)SSD1306_WIDTH) x2 = (int)SSD1306_WIDTH - 1;
    
    for (int x = x1; x <= x2; x++) {
        UI_DrawPixel_BackBuf(x, y, color);
    }
}

/**
 * @brief Отрисовка символа стандартного шрифта 8х16
 */
static void UI_DrawChar_8x16(int x, int y, char c, uint8_t color) {
    if (c < 32 || c > 126) return; 
    uint8_t font_idx = c - 32; // Смещение относительно пробела в ASCII

    for (int row = 0; row < 16; row++) {
        uint8_t line_bits = Font_8x16[font_idx][row]; 
        for (int col = 0; col < 8; col++) {
            if (line_bits & (0x80 >> col)) {
                UI_DrawPixel_BackBuf(x + col, y + row, color);
            } else {
                UI_DrawPixel_BackBuf(x + col, y + row, !color); // Очистка фона (инверсия)
            }
        }
    }
}

/**
 * @brief Вывод строки текста стандартным шрифтом 8х16
 */
static void UI_PrintStr_8x16(int x, int y, const char* str, uint8_t color) {
    while (*str) {
        UI_DrawChar_8x16(x, y, *str, color);
        x += 8; // Шаг строго 8 пикселей
        str++;
    }
}

/**
 * @brief Отрисовка крупного шрифта 16х32 (Цифры тока)
 */
static void UI_DrawBigChar(int x, int y, char c) {
    uint8_t font_idx = 16; // Индекс пробела по умолчанию
    if (c >= '0' && c <= '9') font_idx = c - '0';
    else if (c == 'A' || c == 'a') font_idx = 10;
    else if (c == 'L' || c == 'l') font_idx = 11;
    else if (c == 'R' || c == 'r') font_idx = 12;
    else if (c == 'M' || c == 'm') font_idx = 13;
    else if (c == '!') font_idx = 14;
    else if (c == '-') font_idx = 15;
 
    for (int row = 0; row < 32; row++) {
        // Собираем 16-битную строчку символа из двух последовательных байт Flash
        uint16_t line_bits = (Font_16x32[font_idx][row * 2] << 8) | Font_16x32[font_idx][row * 2 + 1];
        for (int col = 0; col < 16; col++) {
            UI_DrawPixel_BackBuf(x + col, y + row, (line_bits & (0x8000 >> col)) ? 1 : 0);
        }
    }
}

/**
 * @brief Вывод крупной строки 16х32
 */
static void UI_PrintBigStr(int x, int y, const char* str) {
    while (*str) { 
        UI_DrawBigChar(x, y, *str); 
        x += 18; // 16 пикселей символ + 2 пикселя межсимвольный интервал
        str++; 
    }
}

