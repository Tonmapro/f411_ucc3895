{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "BMP Debug (Stable)",
            "cwd": "${workspaceRoot}",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "bmp",
            "BMPGDBSerialPort": "/dev/ttyBmpGdb", 
            "interface": "swd",
            "runToEntryPoint": "main",
            "preLaunchTask": "CMake: build",
            "device": "STM32F411CE",
            "svdFile": "${workspaceFolder}/.vscode/STM32F411.svd",
            "gdbPath": "gdb-multiarch",
            
            // 1. Увеличиваем таймаут глобально
            "overrideLaunchCommands": [
                "set remotetimeout 30",
                "target extended-remote /dev/ttyBmpGdb",
                "monitor swdp_scan",
                "attach 1",
                "load"
            ],

            // 2. ИСПРАВЛЕНИЕ: Это решит проблему с кнопкой Reset
            "overrideRestartCommands": [
                "interrupt",
                "monitor halt",
                "monitor hard_srst",
                "monitor swdp_scan",
                "attach 1",
                "load"
            ],

            // 3. Убираем конфликтующие команды
            "postStartSessionCommands": [], 
            "postRestartCommands": [],

            "showDevDebugOutput": "none" 
        }
    ]
}